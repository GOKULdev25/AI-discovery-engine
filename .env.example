# Copy to .env and fill in. .env is git-ignored; this file is committed.
# Nothing in the codebase reads os.environ directly except backend/app/config.py
# and the frontend's single env module (IP§0.1 rule 3 / EV-INV-03).

# --- Filesystem roots (no absolute-path defaults baked into code) ---
DATA_ROOT=./data
# PROJECTS_ROOT defaults to $DATA_ROOT/projects when unset.

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=["http://localhost:3000"]

# --- Job engine ---
WORKER_COUNT=4
STALE_CLAIM_SECONDS=120

# --- Provider credentials (Phase -1) — leave blank until you have them ---
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ai-discovery-engine/0.1 (by u/YOUR_REDDIT_USERNAME)
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
